{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "20.18.0",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "node": "20.18.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "image": "latest"
      }
    },
    "preview-simulator": {
      "node": "20.18.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "node": "20.18.0",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://moment-backend.azurewebsites.net/api",
        "EXPO_PUBLIC_GOOGLE_PLACES_API_KEY": "AIzaSyC4xWLooS8XR9tOC0V8a4SM-mgewmL5TNs",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": ""
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "ios": {
        "simulator": false,
        "autoIncrement": true,
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
