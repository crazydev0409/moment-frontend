{
  "expo": {
    "name": "Catch",
    "slug": "ios-app",
    "scheme": "catch",
    "version": "1.0.2",
    "extra": {
      "eas": {
        "projectId": "53303aed-83d0-469c-ae4f-8d2c27c784cb"
      }
    },
    "web": {
      "favicon": "./assets/images/icon-android.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location for weather updates."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35,
            "kotlinVersion": "2.0.21",
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to scan booking QR codes."
        }
      ]
    ],
    "orientation": "portrait",
    "icon": "./assets/images/icon-android.png",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "translucent": false,
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#A3CB31"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "./assets/images/icon-ios.png",
      "bundleIdentifier": "com.crazydev0409.catchapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Catch needs your location to provide weather updates and location-based features.",
        "NSLocationAlwaysUsageDescription": "Catch needs your location to provide weather updates and location-based features.",
        "NSContactsUsageDescription": "Catch needs access to your contacts to help you connect with friends and schedule meetings.",
        "NSCameraUsageDescription": "Catch needs your camera to scan booking QR codes.",
        "NSUserNotificationsUsageDescription": "Catch needs to send you notifications about meeting requests and updates.",
        "UIBackgroundModes": ["remote-notification", "fetch"]
      }
    },
    "android": {
      "icon": "./assets/images/icon-android.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-android.png",
        "backgroundColor": "#A3CB31"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.crazydev0409.catchapp",
      "softwareKeyboardLayoutMode": "pan"
    },
    "notification": {
      "icon": "./assets/images/icon-android.png",
      "color": "#000000",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} new notifications"
    },
    "owner": "crazydev0409"
  }
}
